# このファイルを config/targets.yaml にコピーして編集する。
# ここに書いた対象は bot 起動時に監視リストへ取り込まれる(登録済みのものはスキップ)。
# 起動後は Discord の /add /remove コマンドでも追加・削除できる。

# 毎日の通知時刻 (JST, HH:MM)。/settime で変更した場合はそちらが優先される
notify_time: "09:00"

# 監視対象。jan または name のどちらかを指定する。
# name は検索結果がちょうど1件になる程度に具体的に書くこと
# (複数ヒットした場合は取り込まれないので /add で選択して登録する)。
targets:
  - jan: "4549995536447"
  - name: "iPhone 16 Pro Max 256GB 黒"
