# Discord Developer Portal で作成した bot のトークン
DISCORD_BOT_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx

# 通知を送るテキストチャンネルの ID (Discordの開発者モードで右クリック→IDをコピー)
DISCORD_CHANNEL_ID=123456789012345678

# 省略可: SQLite データベースの保存先 (既定: data/monitor.sqlite3)
#DB_PATH=data/monitor.sqlite3

# 省略可: 監視対象の初期設定ファイル (既定: config/targets.yaml)
#TARGETS_YAML=config/targets.yaml
